// How the site is served. This file is the deployment topology, in the
// repository and in review — which is the property the previous arrangement
// lacked: the security policy lived in an nginx.conf that was never part of
// the running topology, and was advertised for months while no response
// carried it.
//
// There is a `main` now, and the paragraph it replaces is still the reason the
// file looks the way it does. It read: "Nothing here executes; the Worker
// serves the contents of dist/ and nothing else. That matters for `_headers`,
// which applies to static assets but *not* to responses generated by Worker
// code — the moment a script starts producing responses, every header in that
// file has to be re-attached by hand, and the ones that get forgotten fail
// silently."
//
// That hazard is real and unchanged. `src/worker.js` is written so as not to
// walk into it: it never builds a response. It asks the assets layer for the
// one it would have served and rewrites a single header on the way out, so
// everything in `_headers` arrives because the assets layer put it there.
//
// What it buys is the `/` language negotiation living in this repository
// instead of in a zone Redirect Rule — reviewable, diffable, and testable
// against `wrangler dev` rather than only against production.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taux-io",
  "compatibility_date": "2026-07-29",
  "main": "src/worker.js",

  // Not a credential — an account identifier, the same one visible in every
  // dashboard URL. It lives here so that deploying needs exactly one secret
  // rather than two, because the setup step most likely to be got wrong is the
  // one nobody can verify without attempting a deploy.
  "account_id": "5164de0801b523f919f7a9eac9bbf9bf",

  "assets": {
    "directory": "./dist",

    // `env.ASSETS` — how src/worker.js asks for the response the assets layer
    // would have served, instead of building one itself.
    "binding": "ASSETS",

    // ONLY `/` RUNS THE WORKER. Everything else is served straight off the
    // assets layer as before, so the `_headers` hazard described at the top of
    // this file has a blast radius of exactly one path.
    //
    // Without this the Worker never sees `/` at all: `_redirects` belongs to
    // the assets layer, it matches first, and the request is answered before
    // any script runs. That is the default and it is the right default — it is
    // also why this line is not optional rather than a tuning knob.
    "run_worker_first": ["/"],

    // Serve 404.html's *contents* with a 404 status. Without this the status is
    // already 404 but the body is Cloudflare's, not the site's. The status is
    // the part that matters to crawlers — a static host answering 200 with a
    // "not found" page is a soft 404, and Google may demote neighbouring paths
    // for it — but the body is what a person sees, so both are asserted.
    "not_found_handling": "404-page",

    // Files are flat: geo-guide.html is served at /geo-guide with no redirect.
    // Anything that treats it as a directory adds a 308 to /geo-guide/ on every
    // indexed URL, and the canonical then points at a form the host does not
    // serve directly. This is the default, written out because it is load
    // bearing rather than incidental.
    "html_handling": "auto-trailing-slash"
  },

  // No *.workers.dev URL. The whole site behind a second permanent hostname is
  // a full duplicate of every indexed page, on a domain whose canonical tags
  // all point elsewhere — an avoidable bet on search engines consolidating it
  // correctly, for a site whose entire purpose is being read by machines.
  "workers_dev": false,

  // Per-version preview URLs stay on: they are where the route contract runs
  // before a version is promoted. They are unlisted and change every version,
  // so they do not carry the standing duplicate-content problem above.
  "preview_urls": true,

  // The hostnames this Worker answers. Attaching these is what replaced the Go
  // host that had been serving taux.io — it rewrites the zone's DNS records to
  // point here, so it is the cutover rather than a description of it.
  //
  // `wrangler versions deploy`, which is what CI runs, does NOT apply trigger
  // changes. Editing this block and pushing therefore changes nothing on its
  // own: it takes a `wrangler deploy` or `wrangler triggers deploy` from a
  // machine with credentials. That split is deliberate — content ships on every
  // merge, hostnames move only when a person decides to move them.
  //
  // www is attached rather than left pointing at the old origin, and is then
  // turned into a 301 to the apex by a zone Redirect Rule. It cannot be done in
  // _redirects: Cloudflare's source side accepts paths only and does not
  // support domain-level redirects.
  "routes": [
    { "pattern": "taux.io", "custom_domain": true },
    { "pattern": "www.taux.io", "custom_domain": true }
  ],

  "observability": {
    "enabled": true
  }
}
