{
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./static/css/styles.min.css --minify",
    "build:site": "cargo run --release --manifest-path generator/Cargo.toml",
    "serve": "node scripts/serve.js",
    "watch:css": "tailwindcss -i ./src/input.css -o ./static/css/styles.min.css --watch",
    "check": "cargo fmt --manifest-path generator/Cargo.toml -- --check && cargo clippy --manifest-path generator/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path generator/Cargo.toml && npm run build:site && npm run check:css && npm run check:classes && npm run check:llms && npm run check:md && npm run check:dates && npm run check:jsonld && npm run check:design && npm run check:hero-water && npm run check:routes && npm run check:entity && npm run check:ko && npm run check:i18n && npm run test:worker",
    "check:css": "sh scripts/check-css-fresh.sh",
    "check:classes": "node scripts/check-unknown-classes.js",
    "check:llms": "node scripts/check-llms.js",
    "check:md": "node scripts/check-md.js",
    "md:audit": "node scripts/md-audit",
    "check:dates": "node scripts/dates.js --check",
    "check:jsonld": "node scripts/check-jsonld.js",
    "check:entity": "node scripts/check-entity.js",
    "check:entity:links": "node scripts/check-entity.js --links",
    "check:ko": "node scripts/check-ko.js",
    "check:i18n": "node scripts/i18n-extract.js gate",
    "check:locale-drift": "node scripts/check-locale-drift.js",
    "test:worker": "node --test scripts/worker.test.mjs scripts/serve.test.mjs",
    "ko:record": "node scripts/check-ko.js --record",
    "check:design": "node scripts/check-design.js",
    "check:hero-water": "node scripts/check-hero-water.js",
    "check:routes": "node scripts/check-routes.js",
    "hooks:install": "git config core.hooksPath .githooks",
    "routes:record": "node scripts/check-routes.js --record",
    "dates": "node scripts/dates.js",
    "screenshot": "node scripts/visual/screenshot.js",
    "contrast": "node scripts/visual/contrast.js",
    "contract": "node scripts/visual/contract.js",
    "water": "node scripts/visual/water.js",
    "geometry": "node scripts/visual/geometry.js",
    "diff": "node scripts/visual/diff.js",
    "build:icons": "node scripts/assets/build-icons.js",
    "build:og": "node scripts/assets/build-og.js",
    "build:assets": "npm run build:icons && npm run build:logo && npm run build:water && npm run build:og",
    "build:logo": "node scripts/assets/build-logo.js",
    "build:water": "node scripts/assets/build-water.js",
    "md:prove": "node scripts/md-audit/prove-whitelist.js",
    "cards": "node scripts/visual/cards.js",
    "blank": "node scripts/visual/blank.js"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "opencc-js": "^1.4.1",
    "playwright": "^1.57.0",
    "postcss": "^8.4.47",
    "sharp": "^0.35.2",
    "smol-toml": "^1.7.1",
    "tailwindcss": "^3.4.14",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "node": ">=22"
  }
}
